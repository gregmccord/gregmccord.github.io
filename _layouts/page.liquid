---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    {% if page.formatted_title %}
      <h1 class="post-title">{{ page.formatted_title }}</h1>
    {% else %}
      <h1 class="post-title">{{ page.title }}</h1>
    {% endif %}

    <div class="post-description">
      <p class="post-description-text">{{ page.description }}</p>

      {% if page.full_paper_pdf or page.repository_link or page.website_link %}
        {% include page_links.liquid %}
      {% endif %}
    </div>
  </header>

  <article>
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
