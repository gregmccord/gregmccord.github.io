{% assign series_posts = site.posts | where: 'series_member', page.series_member | sort: 'date' %}
{% assign series_urls = series_posts | map: 'url' %}
{% for post in series_posts %}
  {% if post.url == page.url %}
    {% assign current_index = forloop.index0 %}
    {% break %}
  {% endif %}
{% endfor %}

{% if current_index > 0 %}
  {% assign prev_index = current_index | minus: 1 %}
  {% assign prev_post = series_posts[prev_index] %}
{% endif %}

{% if current_index < series_posts.size | minus: 1 %}
  {% assign next_index = current_index | plus: 1 %}
  {% assign next_post = series_posts[next_index] %}
{% endif %}

{% if prev_post or next_post %}
  <hr>
  <div style="display: flex; justify-content: space-between; align-items: stretch; width: 100%; height: 100%;">
    {% if prev_post %}
      <div
        style="
          padding: 10px;
          border-radius: 10px;
          margin-right: auto;
          width: 45%;
          cursor: pointer;
          transition: all 0.3s ease;
          border: 2px solid transparent;
        "
        onmouseover="this.style.border='2px solid var(--global-divider-color)'"
        onmouseout="this.style.border='2px solid transparent'"
        onclick="this.blur(); window.location.href='{{ prev_post.url }}'"
      >
        <div style="display: flex; align-items: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="20" viewBox="0 0 50 20" style="vertical-align: middle;">
            <path d="M45 10 L10 10" stroke="var(--global-text-color)" stroke-width="3" fill="none"/>
            <polygon points="7,10 15,5 15,15" fill="var(--global-text-color)"/>
          </svg>
          <div style="margin-left: 5px; display: flex; align-items: center; margin-right: auto;">Previous</div>
        </div>
        {% if prev_post.formatted_title %}
          <div style="text-align: left; padding-top: 5px;">{{ prev_post.formatted_title }}</div>
        {% else %}
          <div style="text-align: left; padding-top: 5px;">{{ prev_post.title }}</div>
        {% endif %}
      </div>
    {% else %}
      <div
        style="
          padding: 10px;
          border-radius: 10px;
          margin-right: auto;
          width: 45%;
        "
      ></div>
    {% endif %}
    <span style="width: 1px; flex-shrink: 0; background-color: var(--global-divider-color); margin: 0 5px;"></span>
    {% if next_post %}
      <div
        style="
          padding: 10px;
          border-radius: 10px;
          margin-left: auto;
          width: 45%;
          cursor: pointer;
          transition: all 0.3s ease;
          border: 2px solid transparent;
        "
        onmouseover="this.style.border='2px solid var(--global-divider-color)'"
        onmouseout="this.style.border='2px solid transparent'"
        onclick="this.blur(); window.location.href='{{ next_post.url }}'"
      >
        <div style="display: flex; align-items: center; justify-content: flex-end;">
          <div style="margin-right: 5px; display: flex; align-items: center; margin-left: auto;">Next</div>
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="20" viewBox="0 0 50 20" style="vertical-align: middle;">
            <path d="M5 10 L40 10" stroke="var(--global-text-color)" stroke-width="3" fill="none"/>
            <polygon points="43,10 35,5 35,15" fill="var(--global-text-color)"/>
          </svg>
        </div>
        {% if next_post.formatted_title %}
          <div style="text-align: right; padding-top: 5px;">{{ next_post.formatted_title }}</div>
        {% else %}
          <div style="text-align: right; padding-top: 5px;">{{ next_post.title }}</div>
        {% endif %}
      </div>
    {% else %}
      <div
        style="
          padding: 10px;
          border-radius: 10px;
          margin-left: auto;
          width: 45%;
        "
      ></div>
    {% endif %}
  </div>
{% endif %}
